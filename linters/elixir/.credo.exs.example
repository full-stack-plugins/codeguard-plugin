# codestyle-check (codeguard): Elixir 规范（Credo 静态分析 + mix format 格式化）
# 使用方法：mix.exs 加 {:credo, "~> 1.7", only: [:dev, :test], runtime: false} 后：
#   mix deps.get
#   mix credo --strict     # 检查（codeguard 钩子走 mix format，此为深度检查）
#   mix format             # 自动格式化
#
# 本文件为 .credo.exs 模板：%{
#   configs: [
#     %{
#       name: "default",
#       files: %{ included: ["lib/", "src/"], excluded: [~r"/_build/", ~r"/deps/"] },
#       checks: %{
#         enabled: [
#           {Credo.Check.Consistency.TabsOrSpaces, []},
#           {Credo.Check.Design.AliasUsage, [priority: :low]},
#           {Credo.Check.Readability.MaxLineLength, [priority: :low, max_length: 120]},
#           {Credo.Check.Warning.LazyLogging, []}
#         ]
#       }
#     }
#   ]
# }
#
# 完整模板参考：https://github.com/rrrene/credo
